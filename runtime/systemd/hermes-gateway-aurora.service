[Unit]
Description=Hermes Agent Gateway - Aurora (SonoraMente)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=aurora
Group=aurora
WorkingDirectory=/home/aurora/.hermes
EnvironmentFile=/home/aurora/.hermes/.env
Environment="HOME=/home/aurora"
Environment="USER=aurora"
Environment="LOGNAME=aurora"
Environment="PATH=/home/aurora/.hermes/hermes-agent/venv/bin:/home/aurora/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/aurora/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/aurora/.hermes"
Environment="TERMINAL_CWD=/home/aurora"
ExecStart=/home/aurora/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
Restart=always
RestartSec=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
